# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.
# Nunca envie valores reais para o GitHub.

# Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Senha única de acesso ao painel
ADMIN_PASSWORD=

# Texto aleatório com 32+ caracteres (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
SESSION_SECRET=

# Opcional: domínio curto exibido no painel (ex.: https://prt.link). Sem ele, usa o domínio acessado.
SHORT_BASE_URL=
